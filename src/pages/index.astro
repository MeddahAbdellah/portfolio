---
import "@/styles/globals.css";
import { InterviewChat } from "@/components/interview-chat";
import { SEO } from "astro-seo";
import SpeedInsights from "@vercel/speed-insights/astro";

const description =
  "Interview Meddah Abdallah's AI portfolio about his experience, engineering decisions, and public work.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f4ef" />
    <SEO
      title="Ask Meddah — AI portfolio interview"
      description={description}
      canonical="https://www.meddahabdallah.pro"
      openGraph={{
        basic: {
          title: "Ask Meddah — AI portfolio interview",
          type: "website",
          image: "https://www.meddahabdallah.pro/logo.png",
          url: "https://www.meddahabdallah.pro",
        },
      }}
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>Ask Meddah</title>
  </head>
  <body>
    <InterviewChat client:load />
    <SpeedInsights />
  </body>
</html>
